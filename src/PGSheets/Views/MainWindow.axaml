<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PGSheets.Controls"
        x:Class="PGSheets.Views.MainWindow"
        Title="PGSheets"
        Width="1100"
        Height="720"
        MinWidth="640"
        MinHeight="400">

  <DockPanel LastChildFill="True">

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGesture="Ctrl+N" Click="OnNewClicked" />
        <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="OnOpenClicked" />
        <Separator />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="OnSaveClicked" />
        <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="OnSaveAsClicked" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClicked" />
      </MenuItem>

      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoMenuItem" Header="_Undo" InputGesture="Ctrl+Z" Click="OnUndoClicked" />
        <MenuItem x:Name="RedoMenuItem" Header="_Redo" InputGesture="Ctrl+Y" Click="OnRedoClicked" />
        <Separator />
        <MenuItem x:Name="CutMenuItem" Header="Cu_t" InputGesture="Ctrl+X" Click="OnCutClicked" />
        <MenuItem x:Name="CopyMenuItem" Header="_Copy" InputGesture="Ctrl+C" Click="OnCopyClicked" />
        <MenuItem x:Name="PasteMenuItem" Header="_Paste" InputGesture="Ctrl+V" Click="OnPasteClicked" />
        <Separator />
        <MenuItem Header="C_lear Contents" Click="OnClearClicked" />
        <Separator />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="OnSelectAllClicked" />
      </MenuItem>

      <MenuItem Header="_Sheet">
        <MenuItem Header="Insert _Rows" Click="OnInsertRowsClicked" />
        <MenuItem Header="Insert _Columns" Click="OnInsertColumnsClicked" />
        <Separator />
        <MenuItem Header="Delete Ro_ws" Click="OnDeleteRowsClicked" />
        <MenuItem Header="Delete Col_umns" Click="OnDeleteColumnsClicked" />
        <Separator />
        <MenuItem Header="_Number format">
          <MenuItem Header="General" Click="OnNumberFormatClicked" />
          <Separator />
          <MenuItem Header="0" Click="OnNumberFormatClicked" />
          <MenuItem Header="0.00" Click="OnNumberFormatClicked" />
          <MenuItem Header="#,##0" Click="OnNumberFormatClicked" />
          <MenuItem Header="#,##0.00" Click="OnNumberFormatClicked" />
          <MenuItem Header="0%" Click="OnNumberFormatClicked" />
          <MenuItem Header="0.0%" Click="OnNumberFormatClicked" />
          <MenuItem Header="$#,##0.00" Click="OnNumberFormatClicked" />
          <MenuItem Header="0000" Click="OnNumberFormatClicked" />
          <Separator />
          <MenuItem Header="yyyy-mm-dd" Click="OnNumberFormatClicked" />
          <MenuItem Header="yyyy-mm-dd hh:mm" Click="OnNumberFormatClicked" />
          <MenuItem Header="hh:mm:ss" Click="OnNumberFormatClicked" />
        </MenuItem>
      </MenuItem>
    </Menu>

    <!-- Name box + formula bar, kept in sync with the active cell. -->
    <Border DockPanel.Dock="Top" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4">
      <Grid ColumnDefinitions="120,*">
        <TextBox x:Name="NameBox"
                 Grid.Column="0"
                 Margin="0,0,4,0"
                 IsReadOnly="True"
                 HorizontalContentAlignment="Center" />
        <TextBox x:Name="FormulaBar" Grid.Column="1" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="6,3">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   Text="Ready"
                   FontSize="12"
                   Foreground="#5F6368"
                   TextTrimming="CharacterEllipsis" />
        <!-- Excel-style aggregate of the selected numbers. -->
        <TextBlock x:Name="SelectionText"
                   Grid.Column="1"
                   Margin="16,0,0,0"
                   FontSize="12"
                   Foreground="#5F6368" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">

      <!--
        The grid and the single reusable editor share one cell. The editor is positioned with a
        margin derived from the grid's cell geometry, so exactly one TextBox exists for the whole
        sheet and it is only ever repositioned, never recreated.
      -->
      <Grid Grid.Row="0" Grid.Column="0" ClipToBounds="True">
        <controls:SpreadsheetGridControl x:Name="SheetGrid" />

        <TextBox x:Name="CellEditor"
                 IsVisible="False"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 BorderBrush="#1A73E8"
                 BorderThickness="2"
                 Padding="2,0"
                 VerticalContentAlignment="Center" />
      </Grid>

      <ScrollBar x:Name="VScroll" Grid.Row="0" Grid.Column="1" Orientation="Vertical" />
      <ScrollBar x:Name="HScroll" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" />

    </Grid>

  </DockPanel>
</Window>
