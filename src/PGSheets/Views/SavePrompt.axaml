<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PGSheets.Views.SavePrompt"
        Title="PGSheets"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="16" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="_Cancel" Click="OnCancelClicked" />
      <Button x:Name="DiscardButton" Content="Do_n't Save" Click="OnDiscardClicked" />
      <Button x:Name="SaveButton" Content="_Save" Click="OnSaveClicked" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
